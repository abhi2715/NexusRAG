# ── Server-side key (recommended for deployments) ──────────────────────────
# Set this in Vercel → Project → Settings → Environment Variables.
# It's read only by the serverless proxy in api/groq.js and never reaches the browser.
# NOTE: no REACT_APP_ prefix. A REACT_APP_* variable would be baked into the public JS bundle.
GROQ_API_KEY=

# Optional default model shown in the UI (safe to expose).
REACT_APP_GROQ_MODEL=llama-3.3-70b-versatile
